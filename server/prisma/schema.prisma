generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String                @id @default(cuid())
  username           String                @unique
  country            String
  nativeLang         String
  passwordHash       String
  preferredCountries Json?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  sentMessages       Message[]             @relation("MessageSender")
  participants       DialogueParticipant[]

  @@index([country])
  @@index([nativeLang])
}

model Dialogue {
  id           String                @id @default(cuid())
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  participants DialogueParticipant[]
  messages     Message[]
}

model DialogueParticipant {
  id         String   @id @default(cuid())
  dialogueId String
  userId     String
  dialogue   Dialogue @relation(fields: [dialogueId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([dialogueId, userId])
  @@index([userId])
  @@index([dialogueId])
}

model Message {
  id                 String   @id @default(cuid())
  dialogueId         String
  senderId           String
  originalText       String
  translatedText     String?
  sourceLang         String
  targetLang         String
  culturalHighlights Json?
  showOriginal       Boolean  @default(false)
  createdAt          DateTime @default(now())
  dialogue           Dialogue @relation(fields: [dialogueId], references: [id], onDelete: Cascade)
  sender             User     @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([dialogueId, createdAt])
  @@index([senderId])
}
